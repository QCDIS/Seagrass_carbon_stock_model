{"nodes": [{"id": "report_carbon_calculation_flowchart", "label": "Carbon Calculation Flowchart", "file_type": "image", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_carbon_calculation_flowchart_emodnet_seagrass_polygons", "label": "EMODnet Seagrass Polygons (input)", "file_type": "concept", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_carbon_calculation_flowchart_marine_eez_regions_polygons", "label": "Marine EEZ Regions Polygons (input)", "file_type": "concept", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_carbon_calculation_flowchart_trained_model_outputs", "label": "Outputs of Trained Model (input)", "file_type": "concept", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_carbon_calculation_flowchart_assign_species_via_eunis_code", "label": "Assign to Species via eunis_code Field", "file_type": "rationale", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EMODnet seagrass polygons carry a EUNIS habitat code rather than a species name; mapping eunis_code to species is required so that species-specific carbon densities from the trained model can be attached to each polygon."}, {"id": "report_carbon_calculation_flowchart_discarded_polygons", "label": "0.13% of Polygons Discarded (insufficient information)", "file_type": "rationale", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polygons whose eunis_code cannot be resolved to a seagrass species lack the information needed to assign a carbon density; they are dropped rather than imputed. The loss is small (0.13% of polygons), so the trade-off favours data integrity over coverage."}, {"id": "report_carbon_calculation_flowchart_assign_polygons_to_eezs", "label": "Assign Seagrass Polygons to EEZs", "file_type": "rationale", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spatial join of seagrass polygons with Marine EEZ regions so that extent and carbon stock can be aggregated and reported per nation."}, {"id": "report_carbon_calculation_flowchart_national_areal_extent", "label": "National Areal Extent A_N", "file_type": "concept", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "report_carbon_calculation_flowchart_assign_inferred_carbon_density", "label": "Assign Inferred Volumetric Carbon Density rho_V to Polygons", "file_type": "rationale", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Volumetric carbon density (rho_V) predicted by the trained model (GPR) is attached to each polygon based on its assigned species, replacing direct field measurements which are sparse."}, {"id": "report_carbon_calculation_flowchart_unit_area_carbon_density", "label": "Unit-Area Carbon Density rho_A = rho_V x depth", "file_type": "concept", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Volumetric density must be integrated over sediment depth to obtain an areal stock density that can be multiplied by polygon area."}, {"id": "report_carbon_calculation_flowchart_aggregated_carbon_stock", "label": "Aggregated Carbon Stock C_N = sum_N A_N x rho_A", "file_type": "concept", "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "National seagrass carbon stock is obtained by combining the per-EEZ areal extent with the unit-area carbon density, giving a per-nation total that is summed for the aggregate."}], "edges": [{"source": "report_carbon_calculation_flowchart_emodnet_seagrass_polygons", "target": "report_carbon_calculation_flowchart_assign_species_via_eunis_code", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "weight": 1.0}, {"source": "report_carbon_calculation_flowchart_assign_species_via_eunis_code", "target": "report_carbon_calculation_flowchart_discarded_polygons", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "weight": 1.0}, {"source": "report_carbon_calculation_flowchart_assign_species_via_eunis_code", "target": "report_carbon_calculation_flowchart_assign_polygons_to_eezs", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "weight": 1.0}, {"source": "report_carbon_calculation_flowchart_assign_species_via_eunis_code", "target": "report_carbon_calculation_flowchart_assign_inferred_carbon_density", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "report/carbon_calculation_flowchart.png", "source_location": null, "weight": 1.0}, {"source": "report_carbon_calculation_flowchart_marine_eez_