        <mxCell id="z47_1i" value="&lt;b&gt;dynamic_point_size&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(extent, n_points, min_s=2.0, max_s=8.0)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/map_panels.py:33&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
