        <mxCell id="z45_7b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z45_7p" target="z45_7o">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z45_8i" value="&lt;b&gt;aggregate_error_bounds&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(df, metric: str=&amp;#x27;stock_Gg&amp;#x27;, groupby_col: str=&amp;#x27;TERRITORY1&amp;#x27;)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/data_processing.py:561&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="25" y="1206" width="340" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_8p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. metric_se = f&amp;quot;{metric}_se&amp;quot;&lt;br&gt;2. g = df.groupby(groupby_col, as_index=False).agg(&lt;br&gt;3. metric_total=(metric, &amp;quot;sum&amp;quot;),&lt;br&gt;4. se_rss=(&lt;br&gt;5. se_upper=(metric_se, lambda s: np.nansum(s.to_numpy(dtype=float)))," style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="405" y="1206" width="730" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_8o" value="&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;implicit result: return g" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1206" width="400" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_8a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z45_8i" target="z45_8p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z45_8b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z45_8p" target="z45_8o">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z45_9i" value="&lt;b&gt;build_national_metrics&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(ea_gdf: gpd.GeoDataFrame)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/data_processing.py:580&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="25" y="1348" width="340" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_9p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. national_metrics = (&lt;br&gt;2. se = pd.to_numeric(g[&amp;quot;stock_kg_ha_se&amp;quot;], errors=&amp;quot;coerce&amp;quot;).to_numpy(dtype=float)&lt;br&gt;3. w = pd.to_numeric(g[&amp;quot;area_ha&amp;quot;], errors=&amp;quot;coerce&amp;quot;).to_numpy(dtype=float)&lt;br&gt;4. x = pd.to_numeric(g[&amp;quot;stock_kg_ha&amp;quot;], errors=&amp;quot;coerce&amp;quot;).to_numpy(dtype=float)&lt;br&gt;5. mask = np.isfinite(se) &amp;amp; np.isfinite(w) &amp;amp; np.isfinite(x) &amp;amp; (w &amp;gt; 0)&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Calls: _weighted_mean_se_upper, aggregate_error_bounds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="405" y="1348" width="730" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_9o" value="&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;implicit result: return national_metrics.merge(bounds, on=&amp;quot;Country&amp;quot;, how=&amp;quot;left&amp;quot;)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1348" width="400" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_9a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z45_9i" target="z45_9p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z45_9b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z45_9p" target="z45_9o">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z45_10i" value="&lt;b&gt;build_comparison_dataframe&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(ea_gdf: gpd.GeoDataFrame, gomis_fp: Path)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/data_processing.py:670&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="25" y="1490" width="340" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_10p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. &amp;quot;&amp;quot;&amp;quot;Build merged comparison dataframe for plotting study vs Gomis estimates.&lt;br&gt;2. gomis_df = load_gomis_table(gomis_fp)&lt;br&gt;3. national_metrics = build_national_metrics(ea_gdf)&lt;br&gt;4. return pd.merge(gomis_df, national_metrics, on=&amp;quot;Country&amp;quot;, how=&amp;quot;outer&amp;quot;)&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Calls: load_gomis_table, build_national_metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
