        </mxCell>
        <mxCell id="z47_5p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. if step &amp;lt;= 0 or not (np.isfinite(lo) and np.isfinite(hi)):&lt;br&gt;2. return np.array([])&lt;br&gt;3. first = np.ceil(lo / step - 1e-12) * step&lt;br&gt;4. last = np.floor(hi / step + 1e-12) * step&lt;br&gt;5. if first &amp;gt; last:" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
