        <mxCell id="z45_11i" value="&lt;b&gt;_weighted_mean_se_upper&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(g: pd.DataFrame)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/data_processing.py:614&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
