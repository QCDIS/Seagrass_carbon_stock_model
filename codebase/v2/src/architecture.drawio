        <mxCell id="z25_0p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. df &amp;lt;- df[order(-df[[value_col]]), , drop = FALSE]&lt;br&gt;2. cum &amp;lt;- cumsum(pmax(df[[value_col]], 0))&lt;br&gt;3. tot &amp;lt;- max(cum, na.rm = TRUE)&lt;br&gt;4. cum &amp;lt;- if (tot &amp;gt; 0) cum / tot else seq_along(cum) / length(cum)&lt;br&gt;5. n_keep &amp;lt;- max(2L, min(as.integer(max_vars)," style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
