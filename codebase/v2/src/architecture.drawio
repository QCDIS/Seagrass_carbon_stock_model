        </mxCell>
        <mxCell id="z2_0p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. b &amp;lt;- basename(normalizePath(run_dir, winslash = &amp;quot;/&amp;quot;, mustWork = FALSE))&lt;br&gt;2. b &amp;lt;- sub(&amp;quot;_\\d{8}_\\d{6}$&amp;quot;, &amp;quot;&amp;quot;, b)&lt;br&gt;3. m &amp;lt;- regexec(&amp;quot;seeds_([0-9]+(?:-[0-9]+)*)$&amp;quot;, b)&lt;br&gt;4. hit &amp;lt;- regmatches(b, m)[[1]]&lt;br&gt;5. if (length(hit) &amp;lt; 2L) return(integer(0))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
