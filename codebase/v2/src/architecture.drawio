        </mxCell>
        <mxCell id="z47_4p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. &amp;quot;&amp;quot;&amp;quot;Pick a nice tick step for map axes.&lt;br&gt;2. steps = np.array([0.25, 0.5, 1, 2, 2.5, 5, 10, 15, 20])&lt;br&gt;3. ideal = max(span / max(target, 1), 1e-9)&lt;br&gt;4. return float(steps[np.argmin(np.abs(steps - ideal))])" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
