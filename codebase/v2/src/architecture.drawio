        <mxCell id="z17_0i" value="&lt;b&gt;compute_map_limits&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(v, use_log = FALSE, log_eps = 1e-6)&lt;/font&gt;&lt;br&gt;&lt;i&gt;modelling/plots/plot_spatial_prediction_maps.R:147&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="25" y="70" width="340" height="116" as="geometry" />
