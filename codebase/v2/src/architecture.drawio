        <mxCell id="z17_1i" value="&lt;b&gt;scale_fill_prediction&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(fill_limits, fill_name, use_log = FALSE)&lt;/font&gt;&lt;br&gt;&lt;i&gt;modelling/plots/plot_spatial_prediction_maps.R:166&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
