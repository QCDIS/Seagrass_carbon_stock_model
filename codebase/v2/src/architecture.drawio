        <mxCell id="z7_0p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. dat &amp;lt;- readRDS(file.path(project_root, &amp;quot;data&amp;quot;, &amp;quot;all_extracted_new.rds&amp;quot;))&lt;br&gt;2. dat &amp;lt;- ensure_model_response(dat)&lt;br&gt;3. dat &amp;lt;- dat[complete.cases(dat[, c(TARGET_VAR, ALL_PREDICTORS), drop = FALSE]), , drop = FALSE]&lt;br&gt;4. pf_preview &amp;lt;- make_pixel_grouped_folds(dat, ALL_PREDICTORS, n_folds = N_FOLDS, seed = CV_SEED)&lt;br&gt;5. tr_preview &amp;lt;- ensure_species_factor(ensure_model_response(dat[pf_preview$fold_indices != 1, , drop = FALSE]))&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Calls: describe_species_encoding, ensure_model_response, make_pixel_grouped_folds, ensure_species_factor, prepare_xgb_onehot_train, compute_train_species_means, fit_fold_model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
