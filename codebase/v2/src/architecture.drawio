        </mxCell>
        <mxCell id="z47_5o" value="&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;implicit result: return first + np.arange(n, dtype=float) * step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
