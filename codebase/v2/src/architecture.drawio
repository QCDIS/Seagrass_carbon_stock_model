        <mxCell id="z17_0p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. v &amp;lt;- v[is.finite(v)]&lt;br&gt;2. if (length(v) == 0L) return(c(0, 1))&lt;br&gt;3. upper &amp;lt;- if (any(v &amp;gt; 0.5, na.rm = TRUE)) 0.25 else max(v, na.rm = TRUE)&lt;br&gt;4. lower &amp;lt;- min(v, na.rm = TRUE)&lt;br&gt;5. if (!is.finite(lower)) lower &amp;lt;- 0" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
