        <mxCell id="z36_7p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. trimmed &amp;lt;- gsub(&amp;quot;^\\s*\\n|\\n\\s*$&amp;quot;, &amp;quot;&amp;quot;, text)&lt;br&gt;2. lines &amp;lt;- strsplit(trimmed, &amp;quot;\n&amp;quot;, fixed = TRUE)[[1L]]&lt;br&gt;3. indent &amp;lt;- regexpr(&amp;quot;[^[:space:]]&amp;quot;, lines)&lt;br&gt;4. common &amp;lt;- min(setdiff(indent, -1L)) - leave&lt;br&gt;5. text &amp;lt;- paste(substring(lines, common), collapse = &amp;quot;\n&amp;quot;)&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Calls: ansify&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
