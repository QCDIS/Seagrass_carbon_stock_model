        <mxCell id="z47_5i" value="&lt;b&gt;extent_grid_ticks&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(lo, hi, step)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/map_panels.py:96&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
