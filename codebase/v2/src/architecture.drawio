        <mxCell id="z17_2i" value="&lt;b&gt;make_spatial_panel&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(grid, fill_col, lon_lim, lat_lim, world, fill_limits, fill_name = &amp;quot;Predicted carbon density&amp;quot;, panel_title = NULL, obs_data = NULL, obs_value_col = target_var, show_obs_points = TRU)&lt;/font&gt;&lt;br&gt;&lt;i&gt;modelling/plots/plot_spatial_prediction_maps.R:189&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
