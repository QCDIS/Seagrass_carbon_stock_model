          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="z17_3i" value="&lt;b&gt;km_to_degree_counts&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(lon_lim, lat_lim, cell_km = 1.0)&lt;/font&gt;&lt;br&gt;&lt;i&gt;modelling/plots/plot_spatial_prediction_maps.R:234&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="25" y="496" width="340" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z17_3p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. mid_lat &amp;lt;- mean(lat_lim)&lt;br&gt;2. km_per_deg_lat &amp;lt;- 111.32&lt;br&gt;3. km_per_deg_lon &amp;lt;- 111.32 * cos(mid_lat * pi / 180)&lt;br&gt;4. km_per_deg_lon &amp;lt;- max(km_per_deg_lon, 1e-6)&lt;br&gt;5. lon_km &amp;lt;- abs(diff(lon_lim)) * km_per_deg_lon" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="405" y="496" width="730" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z17_3o" value="&lt;b&gt;OUTPUT&lt;/b&gt;&lt;br&gt;implicit result: list(n_lon = n_lon, n_lat = n_lat)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1195" y="496" width="400" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z17_3a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z17_3i" target="z17_3p">
