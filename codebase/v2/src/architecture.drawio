        <mxCell id="z17_2p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. p &amp;lt;- ggplot2::ggplot() +&lt;br&gt;2. data = grid,&lt;br&gt;3. data = world,&lt;br&gt;4. fill = &amp;quot;#eeeeee&amp;quot;, colour = &amp;quot;#a5a5a5&amp;quot;&lt;br&gt;5. if (isTRUE(show_obs_points) &amp;amp;&amp;amp; !is.null(obs_data) &amp;amp;&amp;amp; nrow(obs_data) &amp;gt; 0L) {&lt;br&gt;&lt;font color=&quot;#1a73e8&quot;&gt;Calls: scale_fill_prediction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
