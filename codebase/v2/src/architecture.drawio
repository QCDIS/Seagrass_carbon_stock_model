        <mxCell id="z45_7i" value="&lt;b&gt;load_gomis_table&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(gomis_fp: Path)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/data_processing.py:534&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="25" y="1064" width="340" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_7p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. gomis_df = pd.read_csv(gomis_fp).dropna(axis=0, how=&amp;quot;all&amp;quot;)&lt;br&gt;2. cols_to_convert = [&lt;br&gt;3. for col in cols_to_convert:&lt;br&gt;4. if col in gomis_df:&lt;br&gt;5. return gomis_df" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="405" y="1064" width="730" height="116" as="geometry" />
        </mxCell>
