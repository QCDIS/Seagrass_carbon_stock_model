        <mxCell id="z45_11p" value="&lt;b&gt;FLOW&lt;/b&gt;&lt;br&gt;1. se = pd.to_numeric(g[&amp;quot;stock_kg_ha_se&amp;quot;], errors=&amp;quot;coerce&amp;quot;).to_numpy(dtype=float)&lt;br&gt;2. w = pd.to_numeric(g[&amp;quot;area_ha&amp;quot;], errors=&amp;quot;coerce&amp;quot;).to_numpy(dtype=float)&lt;br&gt;3. x = pd.to_numeric(g[&amp;quot;stock_kg_ha&amp;quot;], errors=&amp;quot;coerce&amp;quot;).to_numpy(dtype=float)&lt;br&gt;4. mask = np.isfinite(se) &amp;amp; np.isfinite(w) &amp;amp; np.isfinite(x) &amp;amp; (w &amp;gt; 0)&lt;br&gt;5. if np.sum(mask) == 0 or np.sum(w[mask]) == 0:" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
