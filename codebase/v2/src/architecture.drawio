          <mxGeometry x="1195" y="1064" width="400" height="116" as="geometry" />
        </mxCell>
        <mxCell id="z45_7a" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="z45_7i" target="z45_7p">
