        <mxCell id="z47_4i" value="&lt;b&gt;choose_tick_step&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;(span, target=5)&lt;/font&gt;&lt;br&gt;&lt;i&gt;python_helpers/map_panels.py:81&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
